{
  "commit": {
    "messagePattern": "^(feat|fix|docs|style|refactor|chore|perf|test): .+",
    "forbidAiTrailer": true,
    "forbiddenStaged": ["QA_TOKEN"]
  },
  "deploy": {
    "build": "./gradlew bootJar -q",
    "artifact": "build/libs/app-0.0.1-SNAPSHOT.jar",
    "host": "ubuntu@203.0.113.10",
    "sshKey": "~/.ssh/my_server_key",
    "remotePath": "/opt/my-app/app.jar",
    "owner": "myapp",
    "service": "my-app",
    "healthUrl": "https://example.com/actuator/health",
    "healthTimeoutSec": 240,
    "preCheck": "",
    "checks": [
      { "name": "인증 없는 요청 401", "cmd": "curl -s -o /dev/null -w %{http_code} https://example.com/api/me", "expect": "401" },
      { "name": "세션 쿠키 0개", "cmd": "curl -s -D - -o /dev/null https://example.com/api/me | grep -ci set-cookie", "expect": "0" }
    ],
    "log": "~/.config/devflow/my-app-deploys.log"
  },
  "qa": {
    "appDir": "~/Desktop/my-app",
    "simUdid": "00000000-0000-0000-0000-000000000000",
    "simName": "My QA iPhone",
    "appId": "com.example.myapp",
    "metroPort": 8082,
    "tokenPatch": {
      "file": "src/lib/tokenStorage.ts",
      "marker": "QA_TOKEN",
      "find": "export async function getToken(): Promise<string | null> {\n",
      "replace": "export async function getToken(): Promise<string | null> {\n  // [임시 QA 전용 — 커밋 금지]\n  if (__DEV__ && process.env.EXPO_PUBLIC_QA_TOKEN) return process.env.EXPO_PUBLIC_QA_TOKEN;\n"
    },
    "env": {
      "EXPO_PUBLIC_API_BASE_URL": "http://localhost:8080",
      "EXPO_PUBLIC_QA_TOKEN": "@file:~/.config/devflow/qa-token"
    },
    "snapshotCmd": "echo '쿼리로 테스트 계정 데이터 개수를 출력하는 명령'",
    "quotaCmd": "echo '오늘 외부 API 사용량을 출력하는 명령'",
    "screenshotDir": "~/.config/devflow/shots"
  }
}
